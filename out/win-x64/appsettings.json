{
  "ConnectionStrings": {
    "SixBench": "Data Source=data/sixbench.db"
  },
  "Ffmpeg": {
    "Path": "ffmpeg",
    "VideoEncoder": "libx264",
    "VideoBitrate": "6M",
    "GopSeconds": 1.0,
    "DefaultFrameRate": 30,
    "DefaultVideoSize": null,
    "DefaultPixelFormat": null,
    "ExtraEncoderArgs": null,
    "ProbeTimeoutMs": 8000
  },
  "Streaming": {
    "IdleShutdownSeconds": 10,
    "SubscriberQueueFrames": 120,
    "MaxControlMessageBytes": 16384
  },
  "Audio": {
    "AllowDeviceAudio": true,
    "DeviceBitrate": "128k"
  },
  "Roku": {
    "DiscoveryTimeoutMs": 3000,
    "EcpPort": 8060,
    "RequestTimeoutMs": 3000,
    "TextCharDelayMs": 25
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/sixbench-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
